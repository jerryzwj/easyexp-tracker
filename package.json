{
  "name": "easyexp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "build:cloudflare": "opennextjs-cloudflare",
    "preview:cloudflare": "opennextjs-cloudflare && wrangler pages dev .cloudflare/dist --compatibility-flag=nodejs_compat",
    "deploy": "opennextjs-cloudflare && wrangler pages deploy .cloudflare/dist",
    "d1:create": "wrangler d1 create easyexp-db",
    "d1:migrate:local": "wrangler d1 migrations apply easyexp-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply easyexp-db --remote"
  },
  "dependencies": {
    "next": "16.1.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240101.0",
    "@opennextjs/cloudflare": "^0.4.0",
    "@types/node": "22.7.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.1.5",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3",
    "wrangler": "^3.24.0"
  }
}
