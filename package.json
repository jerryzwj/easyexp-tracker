{
  "name": "easyexp-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "start": "wrangler dev",
    "d1:create": "wrangler d1 create easyexp-db",
    "d1:migrate:local": "wrangler d1 migrations apply easyexp-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply easyexp-db --remote",
    "d1:console": "wrangler d1 execute easyexp-db --local --command=\"SELECT * FROM users LIMIT 1\""
  },
  "dependencies": {
    "hono": "^4.6.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240101.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.60.0"
  }
}
